{
  "name": "raindance",
  "version": "0.1.0",
  "description": "AI Skill Trainer — turn skills packs (SKILL.md) + your prompts into fine-tuning datasets for Claude & ChatGPT",
  "type": "module",
  "bin": {
    "raindance": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "raindance": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai",
    "skills",
    "fine-tuning",
    "openai",
    "anthropic",
    "claude",
    "chatgpt",
    "training-data",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  }
}
